<script>
    function toggleFloatingWidget() {
        const menu = document.getElementById('contactWidgetMenu');
        const icon = document.getElementById('floatingWidgetIcon');
        if (!menu) return;

        if (menu.classList.contains('hidden')) {
            menu.classList.remove('hidden');
            setTimeout(() => {
                menu.classList.remove('scale-95', 'opacity-0');
                menu.classList.add('scale-100', 'opacity-100');
            }, 10);
            if (icon) icon.className = "fa-solid fa-xmark text-2xl transition-transform duration-300 rotate-90";
        } else {
            menu.classList.remove('scale-100', 'opacity-100');
            menu.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                menu.classList.add('hidden');
            }, 200);
            if (icon) icon.className = "fa-solid fa-headset text-2xl transition-transform duration-300";
        }
    }

    // Close floating widget when clicking outside
    document.addEventListener('click', function(e) {
        const container = document.getElementById('floatingWidgetContainer');
        if (!container) return;
        const menu = document.getElementById('contactWidgetMenu');
        if (!menu) return;

        // If click is outside the container and menu is open
        if (!container.contains(e.target) && !menu.classList.contains('hidden')) {
            const icon = document.getElementById('floatingWidgetIcon');
            menu.classList.remove('scale-100', 'opacity-100');
            menu.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                menu.classList.add('hidden');
            }, 200);
            if (icon) icon.className = "fa-solid fa-headset text-2xl transition-transform duration-300";
        }
    });
</script>

<!-- ScrollSpy & Smooth Scroll Offset script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const links = document.querySelectorAll('.toc-link');
        const sections = document.querySelectorAll('main section[id]');

        function changeActiveLink() {
            let index = sections.length;
            while (--index && window.scrollY + 120 < sections[index].offsetTop) {}

            links.forEach((link) => link.classList.remove('active'));
            if (sections[index]) {
                const activeLink = document.querySelector(`.toc-link[href="#${sections[index].id}"]`);
                if (activeLink) {
                    activeLink.classList.add('active');

                    const sidebar = activeLink.closest('aside');
                    if (sidebar) {
                        const activeTop = activeLink.offsetTop;
                        const sidebarHeight = sidebar.clientHeight;
                        const sidebarScrollTop = sidebar.scrollTop;

                        if (activeTop < sidebarScrollTop) {
                            sidebar.scrollTop = activeTop - 10;
                        } else if (activeTop > sidebarScrollTop + sidebarHeight - 40) {
                            sidebar.scrollTop = activeTop - sidebarHeight + 40;
                        }
                    }
                }
            }
        }

        changeActiveLink();
        window.addEventListener('scroll', changeActiveLink);

        // FAQ Accordion
        const faqToggles = document.querySelectorAll('.faq-toggle');
        faqToggles.forEach(toggle => {
            toggle.addEventListener('click', function() {
                const answer = this.nextElementSibling;
                const isOpen = answer.classList.contains('open');

                // Close all other answers
                document.querySelectorAll('.faq-answer').forEach(a => {
                    a.classList.remove('open');
                    a.previousElementSibling.classList.remove('open');
                });

                if (!isOpen) {
                    answer.classList.add('open');
                    this.classList.add('open');
                }
            });
        });
    });
</script>

